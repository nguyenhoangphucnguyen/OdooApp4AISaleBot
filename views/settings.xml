<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_config_settings_view_form_aisalebot"
          model="ir.ui.view">
    <field name="name">res.config.settings.view.form.aisalebot</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>

    <field name="arch" type="xml">

      <!-- Odoo 19 safe anchor -->
      <xpath expr="//form" position="inside">

        <div class="app_settings_block" string="AISaleBot">
          <h2>AISaleBot</h2>

          <div class="row mt16 o_settings_container">

            <!-- Enable -->
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane">
                <field name="aisalebot_enabled"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="aisalebot_enabled"/>
                <div class="text-muted">
                  Enable or disable AISaleBot
                </div>
              </div>
            </div>

            <!-- Script -->
            <div class="col-12 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <label for="aisalebot_embed_script"/>
                <field name="aisalebot_embed_script"/>
                <div class="text-muted">
                  Paste full embed script here
                </div>
              </div>
            </div>

          </div>
        </div>

      </xpath>

    </field>
  </record>

</odoo>
